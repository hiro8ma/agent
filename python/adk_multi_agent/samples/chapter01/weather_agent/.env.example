# ADK はエージェントのディレクトリから親へ遡り、最初に見つけた .env を読む。
# ここに .env が無いと、リポジトリ外の .env が使われることがある。
# 読み込みを止めるには ADK_DISABLE_LOAD_DOTENV=1（true / 1 のみ有効）。
# シェルで明示的に export した値は .env に上書きされない。

# Google AI Studio / Gemini API でローカル確認する場合
GOOGLE_API_KEY=your-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Vertex AI を使う場合は上の 2 行ではなく以下を設定する。
# GOOGLE_GENAI_USE_VERTEXAI=TRUE と GOOGLE_API_KEY を併記すると
# Vertex AI 認証が優先される。
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
