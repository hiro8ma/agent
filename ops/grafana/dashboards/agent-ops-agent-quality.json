      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "id": 11,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_tool_name) (rate(gen_ai_client_operation_duration_seconds_bucket{service_name=~\"$service\", gen_ai_agent_name=~\"$agent\", gen_ai_operation_name=\"execute_tool\"}[$__rate_interval])))",
          "legendFormat": "{{gen_ai_tool_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 5,
            "stacking": {
