          },
          "expr": "sum by (gen_ai_request_model, error_type) (rate(gen_ai_client_operation_duration_seconds_count{service_name=~\"$service\", gen_ai_agent_name=~\"$agent\", gen_ai_operation_name=\"chat\", error_type!=\"\"}[$__rate_interval]))",
