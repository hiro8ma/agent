        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gen_ai_request_model, error_type) (rate(gen_ai_client_retries_total{service_name=~\"$service\"}[$__rate_interval]))",
