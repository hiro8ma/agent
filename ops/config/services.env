# 運用の画面を確かめるときに、ホストで動かすサービスが読む設定。秘密は置かない。
# ほかのリポジトリへ移すときは、この 1 ファイルと scripts/run-services.sh の SERVICES を差し替える。

# ポート
KNOWLEDGE_PORT=19930
CONVERSATION_PORT=19920
ACTION_PORT=19940
AGENT_PORT=19912

# 下流のサービス
KNOWLEDGE_URL=http://localhost:19930
CONVERSATION_URL=http://localhost:19920
ACTION_URL=http://localhost:19940
ACTION_APPROVERS=demo-approver

# テレメトリ（Collector に OTLP で送る）
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRIC_EXPORT_INTERVAL=10000
LOG_FORMAT=plain

# 費用。単価は 100 万トークンあたりの USD で、ここの値は動作確認のための例
GENAI_PRICES="gemini-3.8-flash=0.30/0.03/2.50;gemini-3.8-pro=1.25/0.125/10.00"
GENAI_DAILY_BUDGET_USD=5
